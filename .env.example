# =======================================================
# GLOBAL JOB HUNTER AI — ENVIRONMENT CONFIGURATION
# =======================================================

# Database & Storage
DATABASE_URL=sqlite:////app/data/job_hunter.db
REDIS_URL=redis://localhost:6379/0
RESUME_FOLDER=/home/nx-pro
STORAGE_DIR=/home/nx-pro/global-ai-job-hunter/backend/storage

# AI & LLM Models
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_LLM_MODEL=gemini-2.5-flash

# Telegram Bot API (Instant Alerts & Approval Hooks)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ENABLED=true

# Host & Ports
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
TIMEZONE=Asia/Kolkata

# Automation Policies & Thresholds
MIN_MATCH_SCORE=80
MAX_DAILY_APPLICATIONS=10
JOB_SEARCH_INTERVAL_HOURS=6

# Safety & Mode Controls (Disabled by default for strict compliance)
AUTO_APPLY_ENABLED=false
APPLICATION_APPROVAL_REQUIRED=true

# Data Source & Application Adapter Permissions
ENABLED_JOB_SOURCES=greenhouse,lever,ashby,remotive,remoteok,outlier,alignerr,mercor,handshake,contra,braintrust
AUTHORIZED_APPLICATION_SOURCES=mock_ats,greenhouse_sandbox
