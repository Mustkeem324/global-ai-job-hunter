# =======================================================
# GLOBAL JOB HUNTER AI — PRODUCTION CONFIGURATION (PHASE 4)
# =======================================================

# Core Environment
APP_ENV=production
TIMEZONE=Asia/Kolkata
PROJECT_NAME="Global Job Hunter AI"
VERSION=4.0.0

# Database & Storage
DATABASE_URL=postgresql://jobhunter:securepassword@postgres:5432/jobhunter_db
REDIS_URL=redis://redis:6379/0
RESUME_FOLDER=/app/resumes
STORAGE_DIR=/app/storage

# AI & LLM Engine
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_LLM_MODEL=gemini-2.5-flash
MAX_DAILY_AI_COST_USD=5.0

# Telegram Operational Bot (Instant Alerts & One-Click Execution)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_OWNER_ID=your_telegram_user_id_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
TELEGRAM_ENABLED=true
NOTIFICATION_QUIET_HOURS=23:00-07:00

# Web Command Center & Endpoints
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Automated Discovery Schedules
JOB_DISCOVERY_ENABLED=true
JOB_SEARCH_INTERVAL_HOURS=6
HIGH_PRIORITY_SEARCH_INTERVAL_HOURS=3
DAILY_REPORT_TIME=09:00
WEEKLY_REPORT_DAY=sunday
WEEKLY_REPORT_TIME=19:00

# Quality Control & Matching Thresholds
MIN_MATCH_SCORE=85
MAX_DAILY_APPLICATIONS=10
DEFAULT_COUNTRY=IN
ALLOW_WORLDWIDE_REMOTE=true
RESTRICT_TO_INDIA_ELIGIBLE=true
REQUIRE_VERIFIED_JOB=true
REQUIRE_GEO_ELIGIBILITY=true

# Automation & Safety Policies (Explicit Consent Gate)
AUTO_APPLY_ENABLED=false
APPLICATION_APPROVAL_REQUIRED=true

# Data Source Connectors & Submission Permissions
ENABLED_JOB_SOURCES=greenhouse,lever,ashby,himalayas,jobicy,remotive,arbeitnow,catalog
AUTHORIZED_APPLICATION_SOURCES=mock_ats,greenhouse_sandbox

# Gmail Employer Response Monitoring (OAuth 2.0)
GMAIL_SYNC_ENABLED=false
GMAIL_OAUTH_CLIENT_ID=your_google_client_id_here
GMAIL_OAUTH_CLIENT_SECRET=your_google_client_secret_here

# Follow-Up Management (Strict: Never auto-send without candidate approval)
FOLLOWUP_DRAFTS_ENABLED=true
AUTO_SEND_FOLLOWUPS=false
